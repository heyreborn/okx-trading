# Non-sensitive deployment wiring template. Secret values are supplied as files.
OKX_TRADING_ENVIRONMENT=demo
OKX_TRADING_NODE_ID=local-node-1
OKX_TRADING_CONFIG_PATH=/app/config/versioned-demo-config.toml
# Service names below are for application containers on the Compose network.
OKX_TRADING_DATABASE_URL=postgresql://postgres:5432/okx_trading_dev
OKX_TRADING_DATABASE_PASSWORD_FILE=/run/secrets/database_password
OKX_TRADING_KAFKA_BOOTSTRAP=kafka:9092
OKX_TRADING_OBJECT_STORE_URL=http://object-store:8333
OKX_TRADING_OBJECT_STORE_ACCESS_KEY_FILE=/run/secrets/object_store_access_key
OKX_TRADING_OBJECT_STORE_SECRET_KEY_FILE=/run/secrets/object_store_secret_key
RUST_LOG=info
# Set only the fields required by the selected process role. Trader-only
# references: OKX_TRADING_OKX_API_KEY_FILE, OKX_TRADING_OKX_API_SECRET_FILE,
# and OKX_TRADING_OKX_API_PASSPHRASE_FILE.
