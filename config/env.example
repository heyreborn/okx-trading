# Design template only. Names are provisional until typed config and deployment are implemented.
# Copy to a local .env for development; never put real credentials in this file.
OKX_TRADING_NODE_ID=local-node-1
OKX_TRADING_CONFIG_PATH=/app/config/versioned-demo-config.toml
# Service names below are for application containers on the Compose network.
OKX_TRADING_DATABASE_URL=postgresql://postgres:5432/okx_trading_demo
OKX_TRADING_KAFKA_BOOTSTRAP=kafka:9092
OKX_TRADING_OBJECT_STORE_URL=http://object-store:9000
RUST_LOG=info
# Trader-only credentials are injected by the deployment platform, not stored here.
